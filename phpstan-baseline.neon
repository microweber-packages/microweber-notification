parameters:
	ignoreErrors:
		-
			message: '#^Method MicroweberPackages\\Notification\\Http\\Controllers\\Admin\\NotificationController\:\:index\(\) should return Illuminate\\View\\View but returns Illuminate\\Contracts\\View\\View\.$#'
			identifier: return.type
			count: 1
			path: src/Http/Controllers/Admin/NotificationController.php

		-
			message: '#^Call to an undefined method Illuminate\\Contracts\\Foundation\\Application\:\:getProvider\(\)\.$#'
			identifier: method.notFound
			count: 2
			path: src/Providers/NotificationServiceProvider.php

		-
			message: '#^Call to an undefined method Illuminate\\Contracts\\Foundation\\Application\:\:routesAreCached\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Providers/NotificationServiceProvider.php
